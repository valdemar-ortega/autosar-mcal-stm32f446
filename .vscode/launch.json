{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F446 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/main.elf",
            "device": "STM32F446RE",
            "svdFile": "${workspaceFolder}/STM32F446.svd",
            "configFiles": [
                "board/st_nucleo_f4.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "showDevDebugOutput": "none"
        }
    ]
}
