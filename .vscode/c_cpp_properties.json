{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F446 (arm-none-eabi)",
            "includePath": [
                "${workspaceFolder}/app",
                "${workspaceFolder}/Common/Include",
                "${workspaceFolder}/Platform/Device",
                "${workspaceFolder}/Bsw/Mcal/*/include",
                "${workspaceFolder}/Bsw/Services/*/include",
                "${workspaceFolder}/Bsw/EcuAbstraction/*/include",
                "${workspaceFolder}/Bsw/ComplexDrivers/*/include",
                "${workspaceFolder}/Rte/Generated",
                "${workspaceFolder}/Config/Generated"
            ],
            "defines": [],
            "compilerPath": "/opt/arm-gnu-toolchain/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfloat-abi=soft"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ]
}
